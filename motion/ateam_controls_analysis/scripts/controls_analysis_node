"""Controls analysis republisher node.

Subscribes to every configured robot's ``ateam_radio_msgs/ExtendedTelemetry``
and republishes flat, Foxglove-friendly ``ControlsAnalysis`` messages, one topic
per robot on ``/controls_analysis/robot{id}``. Works for both live streaming and
ROS-bag playback (run this node while playing a bag).

Parameters:
  * ``robot_ids`` (int[], default 0..15): robots to analyze. Each robot ``id``
    subscribes to ``/robot_feedback/extended/robot{id}`` and publishes to
    ``/controls_analysis/robot{id}``.
  * ``input_topic_template`` (str, default
    '/robot_feedback/extended/robot{id}'): input topic template; ``{id}`` is
    replaced with each robot id.
  * ``output_topic_template`` (str, default '/controls_analysis/robot{id}'):
    output topic template; ``{id}`` is replaced with each robot id.
  * ``reliability`` (str, default 'reliable'): 'reliable' or 'best_effort'
    for the telemetry subscription QoS.
  * ``use_robot_time`` (bool, default True): stamp the output header with the
    reconstructed robot timeline (grounded at the first message's ROS time and
    advanced by robot-elapsed time, re-grounded on reboot). When False, the ROS
    receive time is used. In Foxglove select the message ``header.stamp`` to
    plot against this axis.
  * ``reboot_reset_threshold_us`` (int, default 1000000): backward jump in the
    robot microsecond counter treated as a reboot.
  * ``heartbeat_enabled`` (bool, default False): periodically publish
    ``0.0`` on curves that go inactive by control mode (software command +
    per-mode split curves). This is a streaming-viewer aid for tools that trim
    each series relative to its own newest sample; Foxglove plots against a
    fixed time range and does not need it, so it defaults off.
  * ``heartbeat_period_sec`` (float, default 1.0): heartbeat interval, measured
    on the (robot) plot timeline.
"""

import argparse
import sys

from ateam_controls_analysis.routing import (
    apply_heartbeat,
    compute_dimensions,
    robot_timestamp_us,
    RobotClock,
)
from ateam_controls_analysis.telemetry import (
    populate_analysis,
    sample_from_extended,
)
from ateam_controls_analysis_msgs.msg import ControlsAnalysis
from ateam_radio_msgs.msg import ExtendedTelemetry
import rclpy
from rclpy.node import Node
from rclpy.parameter import Parameter
from rclpy.qos import QoSProfile, ReliabilityPolicy
from rclpy.time import Time


DEFAULT_ROBOT_IDS = list(range(16))


class _RobotState:
    """Per-robot streaming state (clock, previous mode, heartbeat timer)."""

    def __init__(self, publisher, reset_threshold_us):
        self.publisher = publisher
        self.clock = RobotClock(reset_threshold_us=int(reset_threshold_us))
        self.prev_mode = None
        self.last_heartbeat_ns = None


class ControlsAnalysisNode(Node):
    """Republishes each robot's ExtendedTelemetry as ControlsAnalysis."""

    def __init__(self, parameter_overrides=None):
        super().__init__('controls_analysis_node',
                         parameter_overrides=parameter_overrides or [])

        robot_ids = self.declare_parameter('robot_ids', DEFAULT_ROBOT_IDS).value
        input_template = self.declare_parameter(
            'input_topic_template', '/robot_feedback/extended/robot{id}').value
        output_template = self.declare_parameter(
            'output_topic_template', '/controls_analysis/robot{id}').value
        reliability = self.declare_parameter('reliability', 'reliable').value
        self._use_robot_time = self.declare_parameter(
            'use_robot_time', True).value
        self._reset_threshold_us = self.declare_parameter(
            'reboot_reset_threshold_us', 1000000).value
        self._heartbeat_enabled = self.declare_parameter(
            'heartbeat_enabled', False).value
        heartbeat_period_sec = self.declare_parameter(
            'heartbeat_period_sec', 1.0).value

        rel = (ReliabilityPolicy.BEST_EFFORT
               if str(reliability).lower() == 'best_effort'
               else ReliabilityPolicy.RELIABLE)
        sub_qos = QoSProfile(depth=50)
        sub_qos.reliability = rel

        self._heartbeat_period_ns = int(float(heartbeat_period_sec) * 1e9)
        self._states = {}
        self._subs = []
        for robot_id in robot_ids:
            robot_id = int(robot_id)
            in_topic = input_template.format(id=robot_id)
            out_topic = output_template.format(id=robot_id)
            pub = self.create_publisher(ControlsAnalysis, out_topic, 50)
            self._states[robot_id] = _RobotState(
                pub, self._reset_threshold_us)
            self._subs.append(self.create_subscription(
                ExtendedTelemetry, in_topic,
                self._make_callback(robot_id), sub_qos))

        self.get_logger().info(
            f'controls_analysis: robots={list(self._states)} '
            f"in='{input_template}' out='{output_template}' "
            f'reliability={reliability} use_robot_time={self._use_robot_time} '
            f'heartbeat_enabled={self._heartbeat_enabled}')

    def _make_callback(self, robot_id):
        state = self._states[robot_id]
        return lambda msg: self._on_telemetry(state, msg)

    def _on_telemetry(self, state, msg):
        ros_now = self.get_clock().now()
        robot_us = robot_timestamp_us(msg.timestamp_us_hi, msg.timestamp_us_lo)
        stamp_ns, reboot = state.clock.update(robot_us, ros_now.nanoseconds)
        plot_stamp_ns = stamp_ns if self._use_robot_time else ros_now.nanoseconds

        bct = msg.body_control_telemetry
        sample = sample_from_extended(msg)

        dims = compute_dimensions(sample, state.prev_mode)
        state.prev_mode = bct.body_control_mode

        # Heartbeat: periodically fill inactive (NaN) mode-dependent curves with
        # 0.0 for streaming viewers that trim each series to its own newest
        # sample. Re-sync on reboot so a re-grounded timeline can't stall it.
        if reboot:
            state.last_heartbeat_ns = None
        if self._heartbeat_enabled:
            if (state.last_heartbeat_ns is None or
                    plot_stamp_ns - state.last_heartbeat_ns >=
                    self._heartbeat_period_ns):
                apply_heartbeat(dims)
                state.last_heartbeat_ns = plot_stamp_ns

        out = ControlsAnalysis()
        if self._use_robot_time:
            out.header.stamp = Time(nanoseconds=stamp_ns).to_msg()
        else:
            out.header.stamp = ros_now.to_msg()
        populate_analysis(
            out, sample, dims, state.clock.reboot_count)

        state.publisher.publish(out)


def _build_arg_parser():
    p = argparse.ArgumentParser(
        prog='controls_analysis_node',
        description="Republish every robot's ExtendedTelemetry as "
                    'Foxglove-friendly ControlsAnalysis, one topic per robot '
                    '(/controls_analysis/robot{id}). Convenience CLI flags '
                    'below set the matching ROS parameters; any extra args '
                    '(e.g. --ros-args ...) are forwarded to rclpy.')
    p.add_argument('--robot-ids', type=int, nargs='+', dest='robot_ids',
                   help='Robots to analyze (default 0..15).')
    p.add_argument('--input-topic-template', dest='input_topic_template',
                   help='Input topic template with {id} (default '
                        '/robot_feedback/extended/robot{id}).')
    p.add_argument('--output-topic-template', dest='output_topic_template',
                   help='Output topic template with {id} (default '
                        '/controls_analysis/robot{id}).')
    p.add_argument('--reliability', choices=['reliable', 'best_effort'],
                   help='Telemetry subscription QoS.')
    p.add_argument('--use-robot-time', action=argparse.BooleanOptionalAction,
                   default=None, dest='use_robot_time',
                   help='Stamp header with reconstructed robot time.')
    p.add_argument('--reboot-reset-threshold-us', type=int,
                   dest='reboot_reset_threshold_us',
                   help='Backward robot-clock jump (us) treated as a reboot.')
    p.add_argument('--heartbeat', action=argparse.BooleanOptionalAction,
                   default=None, dest='heartbeat_enabled',
                   help='Periodically publish 0.0 on inactive mode curves.')
    p.add_argument('--heartbeat-period-sec', type=float,
                   dest='heartbeat_period_sec',
                   help='Heartbeat interval in plot-time seconds.')
    return p


def _overrides_from_args(ns):
    """Map provided (non-None) CLI values to ROS Parameter overrides."""
    names = [
        'robot_ids', 'input_topic_template', 'output_topic_template',
        'reliability', 'use_robot_time', 'reboot_reset_threshold_us',
        'heartbeat_enabled', 'heartbeat_period_sec',
    ]
    overrides = []
    for name in names:
        value = getattr(ns, name)
        if value is not None:
            overrides.append(Parameter(name, value=value))
    return overrides


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    ns, ros_argv = _build_arg_parser().parse_known_args(argv)

    rclpy.init(args=[sys.argv[0], *ros_argv])
    node = ControlsAnalysisNode(parameter_overrides=_overrides_from_args(ns))
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()


if __name__ == '__main__':
    main()
